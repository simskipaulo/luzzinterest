{
  "name": "luzzinterest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "generate": "dotnet run --project tools/CatalogBuilder -- --root .",
    "media": "node scripts/prepare-media.mjs",
    "prepare:content": "npm run generate && npm run media",
    "typecheck": "react-router typegen && tsc --noEmit",
    "dev": "npm run prepare:content && react-router dev --host 127.0.0.1 --port 5173",
    "build": "npm run prepare:content && npm run typecheck && react-router build && node scripts/finalize-build.mjs && node scripts/check-size.mjs",
    "preview": "node scripts/preview.mjs",
    "test:catalog": "dotnet test tools/CatalogBuilder.Tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-router/node": "8.4.0",
    "isbot": "5.2.2",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
